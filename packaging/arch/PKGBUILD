# Builds RusTXT from the checked-out repository (used by the release
# workflow). For the AUR, see ../aur/rustxt-bin/PKGBUILD.
pkgname=rustxt
pkgver=0.6.0
pkgrel=1
pkgdesc="Dead simple, recoverable text editor built with Rust and Iced"
arch=('x86_64' 'aarch64')
url="https://github.com/tsubaie/RusTXT"
license=('MIT')
depends=('libxkbcommon' 'libxkbcommon-x11' 'wayland' 'libx11' 'libxcursor' 'libxi' 'fontconfig')
optdepends=('xdg-desktop-portal: native file dialogs' 'noto-fonts: multilingual text')
makedepends=('cargo')
# LTO and stripping come from the cargo release profile in the workspace
# Cargo.toml (lto = "thin", strip = true); makepkg's lto option only affects C
# flags and its strip is a no-op on the already stripped binary. No debug
# package: the symbols are gone before makepkg sees the binary.
options=('!debug')
source=()

_repo="$startdir/../.."

build() {
  cd "$_repo"
  cargo build --release --locked -p rustxt-iced
}

package() {
  cd "$_repo"
  install -Dm755 target/release/rustxt-iced "$pkgdir/usr/bin/rustxt"
  install -Dm644 data/com.tsubaie.rustxt.desktop "$pkgdir/usr/share/applications/com.tsubaie.rustxt.desktop"
  install -Dm644 data/icons/com.tsubaie.rustxt.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/com.tsubaie.rustxt.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
