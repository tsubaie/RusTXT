# Builds RusTXT from the checked-out repository (used by the release
# workflow). For the AUR, see ../aur/rustxt-bin/PKGBUILD.
pkgname=rustxt
pkgver=0.3.0
pkgrel=1
pkgdesc="Dead simple, recoverable text editor built with GTK 4, libadwaita and GtkSourceView"
arch=('x86_64' 'aarch64')
url="https://github.com/tsubaie/RusTXT"
license=('MIT')
depends=('gtk4' 'libadwaita' 'gtksourceview5')
makedepends=('cargo')
options=('!lto' '!strip')
source=()

_repo="$startdir/../.."

build() {
  cd "$_repo"
  cargo build --release --locked -p rustxt
}

package() {
  cd "$_repo"
  install -Dm755 target/release/rustxt "$pkgdir/usr/bin/rustxt"
  install -Dm644 data/com.tsubaie.rustxt.desktop "$pkgdir/usr/share/applications/com.tsubaie.rustxt.desktop"
  install -Dm644 data/icons/com.tsubaie.rustxt.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/com.tsubaie.rustxt.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
