# Maintainer: Talal A. Alsubaie <t.subaie@gmail.com>
# AUR package installing the prebuilt release binary. The release workflow
# fills pkgver and sha256sums and attaches the result to each GitHub release.
pkgname=rustxt-bin
_pkgname=rustxt
pkgver=@VERSION@
pkgrel=1
pkgdesc="Dead simple, recoverable text editor built with GTK 4, libadwaita and GtkSourceView"
arch=('x86_64')
url="https://github.com/tsubaie/RusTXT"
license=('MIT')
depends=('gtk4' 'libadwaita' 'gtksourceview5')
provides=('rustxt')
conflicts=('rustxt')
source=("$url/releases/download/v$pkgver/rustxt-$pkgver-x86_64-linux.tar.gz")
sha256sums=('@SHA256@')

package() {
  cd "$srcdir/rustxt-$pkgver"
  install -Dm755 rustxt "$pkgdir/usr/bin/rustxt"
  install -Dm644 com.tsubaie.rustxt.desktop "$pkgdir/usr/share/applications/com.tsubaie.rustxt.desktop"
  install -Dm644 com.tsubaie.rustxt.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/com.tsubaie.rustxt.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$_pkgname/LICENSE"
}
